# Portal environment configuration.
#
# Copy this file to `.env` and fill in the values. Bun loads `.env`
# automatically — no extra flags or dotenv package required.
#
# Do NOT commit `.env` to source control: it contains secrets.

# ---------------------------------------------------------------------------
# App (optional — these also have defaults in config.json)
# ---------------------------------------------------------------------------
# PORTAL_ROOT=./data
# PORTAL_PORT=4000
# PORTAL_HOST=0.0.0.0
# PORTAL_MAX_UPLOAD_BYTES=5368709120  # 5 GB per file

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# Flip to "true" once every value below is filled in. With auth disabled the
# portal is wide open to anyone who can reach the port.
PORTAL_AUTH_ENABLED=false

# OAuth 2.0 client (https://console.cloud.google.com/apis/credentials).
# Authorised redirect URI on the client must be exactly:
#   <PORTAL_PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Externally-reachable origin (scheme + host + optional port, no trailing /).
# Must match what you registered with Google.
#   prod: https://portal.example.com
#   dev:  http://localhost:4000
PORTAL_PUBLIC_URL=

# Allowlist — comma-separated. At least one of EMAILS or DOMAINS is required
# when auth is enabled.
#   PORTAL_ALLOWED_EMAILS=alice@example.com,bob@example.com
#   PORTAL_ALLOWED_DOMAINS=example.com
PORTAL_ALLOWED_EMAILS=
PORTAL_ALLOWED_DOMAINS=

# HMAC key for session cookies. Treat like a password; rotate to force
# everyone to sign in again. Generate with:
#   openssl rand -base64 48
PORTAL_SESSION_SECRET=

# Require Secure cookies (HTTPS). Set to "false" ONLY for local http:// dev.
PORTAL_COOKIE_SECURE=true

# Session lifetime in seconds (default 7 days, capped at 30 days).
PORTAL_SESSION_TTL=604800
